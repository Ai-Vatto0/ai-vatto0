{
  "mcpServers": {
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@claude-flow/cli@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    },
    "memory-mcp": {
      "type": "local",
      "path": "C:\\Users\\rober\\ki-app",
      "config": "C:\\Users\\rober\\ki-app\\MCP-CONFIG\\memory-mcp.json",
      "features": {
        "working_memory": "C:\\Users\\rober\\ki-app\\.claude\\CLAUDE.md",
        "knowledge_base": "C:\\Users\\rober\\ki-app\\memory\\",
        "master_index": "C:\\Users\\rober\\ki-app\\MASTER-MEMORY.md",
        "session_logs": "C:\\Users\\rober\\ki-app\\MEMORY.md"
      },
      "autoStart": true,
      "env": {
        "MEMORY_BACKEND": "hybrid",
        "TOKEN_EFFICIENCY": "true",
        "CONTEXT_LIMIT_WORDS": "80"
      }
    }
  }
}
