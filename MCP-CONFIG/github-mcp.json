  "mcpServer": {
    "name": "GitHub MCP – Unified Repo Hub",
    "purpose": "Cross-project Git operations, issue tracking, PR workflow",
    "credentials": {
      "GITHUB_TOKEN": "ghp_xxxx (read from ENV)",
      "GITHUB_ORG": "ai-vatto0"
