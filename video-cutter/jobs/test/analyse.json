  "phrasen": [
    {
      "id": "p0",
      "s": 0.65,
      "e": 4.56,
      "text": "Kennt du das, wenn dein Kaffee nach 10 Minuten schon kalt ist?"
    },
    {
      "id": "p1",
      "s": 5.44,
      "e": 6.92,
      "text": "Mit diesem Becher bleibt er."
    },
    {
      "id": "p2",
      "s": 7.14,
      "e": 7.39,
      "text": "Äh."
    },
    {
      "id": "p3",
      "s": 8.11,
      "e": 9.32,
      "text": "Moment, nochmal."
    },
    {
      "id": "p4",
      "s": 10.91,
      "e": 13.46,
      "text": "Mit diesem Becher bleibt er deutlich länger warm."
    },
    {
      "id": "p5",
      "s": 16.46,
      "e": 18.46,
      "text": "Der Deckel geht mit einer Hand auf."
    },
    {
      "id": "p6",
      "s": 19.45,
      "e": 22.1,
      "text": "Und er passt in meinen Getränkealter im Auto."
    },
    {
      "id": "p7",
      "s": 23.39,
      "e": 24.99,
      "text": "Jetzt im Ticktockshop."
    }
  ]
